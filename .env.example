# Copy this file to `.env` and fill in your values.
# Never commit the real .env - it is gitignored already.

# OpenAI API key (required for OpenAIEmbedder)
ONBOARDING_OPENAI_API_KEY=sk-your-key-here

# Embedding model + dimensions
ONBOARDING_EMBEDDING_MODEL=text-embedding-3-small
ONBOARDING_EMBEDDING_DIMENSIONS=1536

# Chunking
ONBOARDING_CHUNK_SIZE=1000
ONBOARDING_CHUNK_OVERLAP=200

# ChromaDB persistence directory (relative to project root).
# Set ONBOARDING_CHROMA_IN_MEMORY=true to run Chroma in RAM (tests).
ONBOARDING_CHROMA_PERSIST_DIR=data/chroma
ONBOARDING_CHROMA_IN_MEMORY=false

# FastAPI server
ONBOARDING_API_HOST=0.0.0.0
ONBOARDING_API_PORT=8000
